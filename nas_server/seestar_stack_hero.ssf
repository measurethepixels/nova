# SeeStar hero stacking script — maximum quality, plate solve + Lanczos4 interpolation.
# seqplatesolve provides absolute WCS alignment for field-rotated alt-az frames.
# Requires Siril 1.4.3 (fixes headless crash). For speed, use seestar_stack_fast.ssf.

requires 1.4.0

cd light
convert light -debayer -out=../process
cd ../process

seqplatesolve light -nocache -force -order=4 -radius=25
seqapplyreg light -interp=lanczos4

stack r_light rej 3 3 -norm=addscale -output_norm -weight=noise -out=../result

cd ..
