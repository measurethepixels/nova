# SeeStar calibration + registration only — feeds SASpro Image MM or PI ImageIntegration.
# Output: workdir/process/r_light_*.fit (registered frames)
# seqplatesolve provides absolute WCS alignment for field-rotated alt-az frames.
# register -2pass removed: it overwrites seqplatesolve's WCS matrices. Requires Siril 1.4.3.
# No -downscale: defeats small-star detection at SeeStar resolution (2.4"/px).

requires 1.4.0

cd light
convert light -debayer -out=../process
cd ../process

seqplatesolve light -nocache -force -order=4 -radius=25
seqapplyreg light
