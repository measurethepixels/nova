# SeeStar stacking script for Siril 1.4.3+
# SeeStar frames are already camera-calibrated (dark/flat applied on-device).
# seqplatesolve provides absolute WCS alignment — more accurate than image-matching
# register for field-rotated alt-az frames. Requires Siril 1.4.3 (fixes headless crash).
# For speed without plate solve, use seestar_stack_fast.ssf.

requires 1.4.0

cd light
convert light -debayer -out=../process
cd ../process

seqplatesolve light -nocache -force -order=4 -radius=25
seqapplyreg light

stack r_light rej 3 3 -norm=addscale -output_norm -weight=noise -out=../result

cd ..
