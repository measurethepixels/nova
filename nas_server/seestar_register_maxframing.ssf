# SeeStar max-framing register-only — feeds ImageMM or PI.
# seqplatesolve writes WCS + cross-panel offsets to light_.seq.
# register -2pass is intentionally omitted: star-matching overwrites WCS offsets and
# fails for non-overlapping mosaic panels. seqaplyreg uses seqplatesolve WCS directly.

requires 1.4.0

cd light
convert light -debayer -out=../process
cd ../process

seqplatesolve light -nocache -force -order=4 -radius=25
seqapplyreg light -framing=max
